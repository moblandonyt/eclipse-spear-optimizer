{
	"schemaVersion": 1,
	"id": "eclipse-sky-spear-optimizer",
	"version": "${version}",
	"name": "Eclipse Sky Spear Optimizer",
	"description": "Swaps to a Lunge spear, attacks, and swaps back.",
	"authors": [
		"Me!"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/eclipse-sky-spear-optimizer/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"eclipseskyspearoptimizer.EclipseSkySpearOptimizer"
		],
		"client": [
			"eclipseskyspearoptimizer.client.EclipseSkySpearOptimizerClient"
		]
	},
	"mixins": [
		"eclipse-sky-spear-optimizer.mixins.json",
